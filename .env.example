# FAHAM settings: one file for Docker Compose and the API. Copy to .env (git ignores .env) and edit.
#   cp .env.example .env
# Never commit .env or paste its values into chat.

# Port the site listens on at http://localhost:<WEB_PORT>. Change it if 8080 is taken.
WEB_PORT=8080

# ---- Cloudflare Tunnel (public https address; README "Public access") ----
# Named tunnel: create the tunnel in the Cloudflare Zero Trust dashboard (Tunnels), copy its token here,
# and give it a public hostname whose service is  http://web:80
# Then start it with:  docker compose --profile tunnel up -d
# Treat the token like a password: never commit it or paste it in chat.
CLOUDFLARE_TUNNEL_TOKEN=

# Quick tunnel (no account, random address, short demos) needs no setting here:
#   docker compose --profile quick up -d quicktunnel && docker compose logs quicktunnel

# ================= API settings =================
FAHAM_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
# LLM provider(s), tried in order: "none", "ilmu", "anthropic", or "ilmu,anthropic"
FAHAM_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
FAHAM_LLM_MODEL_ILMU=ilmu-mini-v3.3
FAHAM_LLM_MODEL_ANTHROPIC=claude-sonnet-5-5
# Set to 1 only for local dev when opening index.html from disk (file://)
FAHAM_ALLOW_NULL_ORIGIN=0
# ILMU (OpenAI-compatible, https://docs.ilmu.ai). Default model when provider=ilmu: ilmu-mini-v3.3
ILMU_API_KEY=
ILMU_BASE_URL=https://api.ilmu.ai/v1
# ILMU text to speech (Malay, English, Mandarin; Tamil uses the browser voice). RM 0.08 per 1,000 characters
FAHAM_TTS_MODEL=ilmu-tts-v2.1
FAHAM_TTS_VOICE=voice_1

# ---- Public access through Cloudflare Tunnel (root .env.example has the tunnel token) ----
# The page and /api share one address, so FAHAM_ALLOWED_ORIGINS needs no change for the tunnel hostname.
# Set FAHAM_PUBLIC_URL below to the tunnel address (https://faham.example.com) so the privacy notice links to your Terms page.
# Partner sites allowed to frame /embed.html are set in frontend/nginx.conf ($embed_ancestors); FAHAM_EMBED_ORIGINS is informational.

# ---- Messaging channels (docs/INTEGRATIONS.md). Empty = channel inert ----
FAHAM_PUBLIC_URL=
FAHAM_EMBED_ORIGINS=
# Key for hashing sender ids (random per process if empty; consent is forgotten on restart either way)
CHANNEL_HASH_KEY=
GRAPH_VERSION=v21.0
# Messenger Platform
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_USERNAME=
# Email: forwarding mailbox polled over IMAP, replies over SMTP (STARTTLS)
# Mailtrap Inbound instead of IMAP (docs/INTEGRATIONS.md): reads forwarded mail over Mailtrap's API.
# MAILTRAP_INBOX_ID is the number of the inbound inbox (not its address). Needs SMTP_* below for the replies.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
# ...or a mailbox over IMAP (used only if the two Mailtrap settings above are empty)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_PUBLIC_ADDRESS=
# Shared secret for POST /api/channels/email (raw RFC822 push, no auto reply)
EMAIL_WEBHOOK_SECRET=
